#!/usr/bin/env bash
# Copyright 2026, Daniel Scholl
# SPDX-License-Identifier: MIT
#
# The checks a bead must pass. CI runs all of them and scripts/land waits for it; see docs/sdlc.md.
#   scripts/check           everything: lint, typecheck, every test twice, headers, licenses
#   scripts/check --static  before a landing waits on CI: lint, typecheck and headers, no test
#   scripts/check --quick   while building or reviewing: lint, typecheck, headers, and once,
#                           the tests the diff against main reaches and the packages that
#                           depend on what it changes
set -euo pipefail

quick=
static=
if (($# > 1)); then
  echo "check: unexpected option $2 (usage: scripts/check [--quick | --static])" >&2
  exit 2
fi
case ${1:-} in
  "") ;;
  --quick) quick=1 ;;
  --static) static=1 ;;
  *)
    echo "check: unknown option $1 (usage: scripts/check [--quick | --static])" >&2
    exit 2
    ;;
esac

cd "$(git rev-parse --show-toplevel)"

# Bun 1.3.3 closes sockets in the record-sweep proxy tests; 1.3.13 is the supported floor.
if command -v bun >/dev/null 2>&1; then
  bun_version=$(bun --version)
  IFS=. read -r bun_major bun_minor bun_patch <<<"$bun_version"
  if ((bun_major < 1 || (bun_major == 1 && (bun_minor < 3 || (bun_minor == 3 && bun_patch < 13))))); then
    echo "check: Bun >= 1.3.13 required for record-sweep tests; found $bun_version" >&2
    exit 1
  fi
fi

if [[ -f package.json ]]; then
  if [[ ! -d node_modules ]]; then
    pnpm install --frozen-lockfile
  fi
  if [[ -n $static ]]; then
    pnpm run lint
    pnpm run typecheck
    pnpm run check:headers
    echo "check: static pass only; no test ran"
    exit 0
  fi
  if [[ -n $quick ]]; then
    base=$(git merge-base HEAD main)
    pnpm run lint
    pnpm run typecheck
    pnpm run check:headers
    node scripts/watch-generated.mjs
    changed=$({ git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u)
    # Vitest follows imports. It does not follow one package into another's built output, a
    # fixture, or a script a test reads from disk, so those projects run whole, and the
    # import-following run covers only the rest: no test runs twice.
    whole=()
    projects=$(node scripts/check-dependents.mjs <<<"$changed")
    while IFS= read -r project; do
      [[ -n $project ]] && whole+=(--project "$project")
    done <<<"$projects"
    if ((${#whole[@]} == 0)); then
      pnpm run test --changed "$base" --passWithNoTests
    else
      rest=()
      projects=$(node scripts/check-dependents.mjs --rest <<<"$changed")
      while IFS= read -r project; do
        [[ -n $project ]] && rest+=(--project "$project")
      done <<<"$projects"
      if ((${#rest[@]})); then
        pnpm run test --changed "$base" --passWithNoTests "${rest[@]}"
      fi
      pnpm run test "${whole[@]}"
    fi
    beside=()
    while IFS= read -r path; do
      [[ $path == *.ts || $path == *.tsx ]] && continue
      test=${path%.*}.test.ts
      [[ -f $test ]] || continue
      # A project that runs whole has already run it.
      for project in ${whole[@]+"${whole[@]}"}; do
        [[ $test == "$project"/* ]] && continue 2
      done
      beside+=("$test")
    done <<<"$changed"
    if ((${#beside[@]})); then
      pnpm run test "${beside[@]}"
    fi
    echo "check: quick pass only; CI runs every test, twice, before scripts/land moves main"
    exit 0
  fi
  # CI sets SPI_CHECK_REPORT_DIR to keep vitest's JSON report of each pass for its timings.
  report=()
  if [[ -n ${SPI_CHECK_REPORT_DIR:-} ]]; then
    mkdir -p "$SPI_CHECK_REPORT_DIR"
    report=(--reporter=default --reporter=json)
  fi
  # The steps of `pnpm run check`, spelled out so the watch fixtures are generated from the
  # typechecked build before the tests, and the test step can take the reporter.
  pnpm run lint
  pnpm run typecheck
  node scripts/watch-generated.mjs
  if ((${#report[@]})); then
    pnpm run test "${report[@]}" "--outputFile.json=$SPI_CHECK_REPORT_DIR/pass-1.json"
  else
    pnpm run test
  fi
  pnpm run check:headers
  # A second zone too, so a test that only passes in this machine's zone fails here, not in CI.
  zone=UTC
  if [[ $(node -e 'process.stdout.write(String(new Date().getTimezoneOffset()))') == 0 ]]; then
    zone=Pacific/Kiritimati
  fi
  echo "check: testing with the wall clock 400 days forward in time zone $zone"
  if ((${#report[@]})); then
    SPI_TEST_ZONE=$zone SPI_TEST_CLOCK_SHIFT=1 pnpm run test "${report[@]}" "--outputFile.json=$SPI_CHECK_REPORT_DIR/pass-2.json"
  else
    SPI_TEST_ZONE=$zone SPI_TEST_CLOCK_SHIFT=1 pnpm run test
  fi
  node scripts/third-party-notices.mjs
  exit 0
fi

# Until the M0 scaffold adds package.json, the repo is docs and scripts only.
base=$(git merge-base HEAD main 2>/dev/null || git rev-parse HEAD)
git diff --check "$base"
for f in scripts/*; do
  bash -n "$f"
done
echo "check: ok"
