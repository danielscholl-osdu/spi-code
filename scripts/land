#!/usr/bin/env bash
# Copyright 2026, Daniel Scholl
# SPDX-License-Identifier: MIT
#
# Lands one bead on main. The only path to main; see docs/sdlc.md.
#   scripts/land <bead-id>
# Rerunning after a failed push finishes the landing.
set -euo pipefail
export BD_DISABLE_METRICS=1 OTEL_SDK_DISABLED=true
# Read the objects the ids name, never a local replacement for them.
export GIT_NO_REPLACE_OBJECTS=1

die() { echo "land: $*" >&2; exit 1; }

id=${1:?usage: scripts/land <bead-id>}
branch="bead/$id"
command -v jq >/dev/null || die "jq is required"

# Written by scripts/watch-snapshot.ts. A test compares each with a fresh projection, so
# scripts/check vouches for these files and a review does not have to cover them.
generated=(
  fixtures/watch/inspect-1106.json
  fixtures/watch/snapshot-1106-unread.json
  fixtures/watch/snapshot-1106-unverified.json
  fixtures/watch/snapshot-1106.json
  fixtures/watch/snapshot-59d6895.json
  fixtures/watch/snapshot-bad.json
  fixtures/watch/snapshot-busy.json
  fixtures/watch/snapshot-calm.json
  fixtures/watch/snapshot-mixed-59d6895.json
)

root=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
[[ -n $root ]] || die "cannot find the main checkout"
has_remote() { git -C "$root" remote get-url origin >/dev/null 2>&1; }

worktree=$(git worktree list --porcelain | awk -v ref="refs/heads/$branch" '
  /^worktree /{ path = substr($0, 10) }
  $0 == "branch " ref { print path; exit }')

bead=$(bd show "$id" --json | jq 'if type == "array" then .[0] else . end')
[[ $(jq -r '.id // empty' <<<"$bead") == "$id" ]] || die "bead $id not found"
status=$(jq -r '.status' <<<"$bead")
[[ $status == in_progress ]] || die "$id is $status, not in_progress"
assignee=$(jq -r '.assignee // empty' <<<"$bead")
[[ -n $assignee ]] || die "$id has no assignee; claim it first"
meta() { jq -r --arg k "$1" '.metadata[$k] // empty' <<<"$bead"; }
has_label() { jq -e --arg l "$1" '(.labels // []) | index($l) != null' <<<"$bead" >/dev/null; }

check_line() {
  local broken
  broken=$(bd list --label main-broken --status open,in_progress,blocked,deferred,hooked --limit 0 --json | jq -r '.[].id')
  if [[ -n $broken ]] && ! grep -qx "$id" <<<"$broken"; then
    die "main is broken ($(tr '\n' ' ' <<<"$broken")); only its fix may land"
  fi
}

[[ $(git -C "$root" symbolic-ref --short HEAD) == main ]] || die "main checkout at $root is not on main"
[[ -z $(git -C "$root" status --porcelain) ]] || die "main checkout at $root has uncommitted changes"

holder="land:$id:$$"
bd merge-slot acquire --holder "$holder" >/dev/null || die "the merge slot is held; try again shortly"
trap 'bd merge-slot release --holder "$holder" >/dev/null || echo "land: release the merge slot: bd merge-slot release" >&2' EXIT

# Every mode, type, id and path in a tree, without the generated fixtures.
entries() {
  git -C "$root" ls-tree -r --full-tree "$1" |
    SKIP="${generated[*]}" awk -F'\t' '
      BEGIN { n = split(ENVIRON["SKIP"], path, " "); for (i = 1; i <= n; i++) skip[path[i]] = 1 }
      !($2 in skip)'
}

finish() {
  local sha=$1
  if has_remote; then
    git -C "$root" push --quiet origin main ||
      die "$sha is on local main but the push failed; fix the remote, then rerun scripts/land $id"
  fi
  bd close "$id" --actor "$assignee" --reason "Landed $(git -C "$root" rev-parse --short "$sha")" >/dev/null
  git -C "$root" update-ref -d "refs/reviewed/$id"
  echo "land: $id landed as $(git -C "$root" rev-parse --short "$sha")"
  case $worktree in
    "$root"/.worktrees/*)
      git -C "$root" worktree remove "$worktree"
      git -C "$root" branch --quiet -D "$branch"
      ;;
    "") ;;
    *) echo "land: left $worktree in place; the harness that made it removes it" ;;
  esac
}

landed=$(meta land.sha)
tip=$(git -C "$root" rev-parse -q --verify "refs/heads/$branch" || true)
if [[ -n $landed && ( -z $tip || $tip == "$landed" ) ]] &&
  git -C "$root" merge-base --is-ancestor "$landed" main 2>/dev/null &&
  [[ -z $worktree || -z $(git -C "$worktree" status --porcelain) ]]; then
  finish "$landed"
  exit 0
fi

check_line
[[ -n $worktree ]] || die "no worktree has $branch checked out"
[[ -z $(git -C "$worktree" status --porcelain) ]] || die "$worktree has uncommitted changes"

if has_remote; then
  git -C "$root" fetch --quiet origin main
  git -C "$root" merge --quiet --ff-only origin/main || die "local main has diverged from origin/main"
fi

if ! git -C "$worktree" rebase --quiet main; then
  git -C "$worktree" rebase --abort
  die "$branch does not rebase cleanly onto main; resolve it in $worktree, then review again"
fi
head=$(git -C "$worktree" rev-parse HEAD)
base=$(git -C "$root" rev-parse main)
[[ $(git -C "$root" merge-base "$base" "$head") == "$base" ]] || die "$branch is not on top of main after the rebase"
[[ $head != "$base" ]] || die "$branch has no changes against main"

ai_agent='(^|[^[:alnum:]])(copilot|claude|codex|gpt|gemini|muse)([^[:alnum:]]|$)'
ai_email='<(noreply@(anthropic|openai)\.com|([^<>]*[+._-])?(copilot|claude|codex|gpt|gemini|muse)(\[bot\])?@users\.noreply\.github\.com)>'
commits=$(git -C "$root" rev-list "$base..$head")
while IFS= read -r commit; do
  message=$(git -C "$root" show -s --format=%B "$commit")
  coauthors=$({
    git interpret-trailers --only-trailers --unfold <<<"$message"
    tr -d '\r' <<<"$message"
  } | awk 'tolower($0) ~ /^[[:space:]]*co-authored-by[[:space:]]*:/')
  if { sed 's/<[^>]*>//g' <<<"$coauthors" | grep -Ei "$ai_agent" >/dev/null; } ||
    grep -Ei "$ai_email" <<<"$coauthors" >/dev/null ||
    grep -Ei '^[^[:alnum:]]*generated[[:blank:]]+with([[:blank:]]|$)' <<<"$message" >/dev/null; then
    die "commit $commit on $branch has AI attribution; in $worktree run git rebase -i main and mark $commit as reword to remove it (keep the Bead trailer)"
  fi
done <<<"$commits"

# The rebase may bring dependencies main gained since the worktree was installed.
if [[ -f "$worktree/package.json" ]]; then
  (cd "$worktree" && pnpm install --frozen-lockfile --silent) || die "pnpm install failed on $branch"
fi
(cd "$worktree" && scripts/check) || die "scripts/check failed on $branch"
[[ $(git -C "$worktree" rev-parse HEAD) == "$head" ]] || die "$branch moved while checks ran"
[[ -z $(git -C "$worktree" status --porcelain) ]] || die "checks left changes in $worktree"

if has_label review:exempt; then
  while IFS= read -r -d '' path; do
    [[ $path == *.md ]] || die "review:exempt covers Markdown only; $path is not"
    case $path in
      design/* | .agents/* | AGENTS.md) die "review:exempt does not cover $path" ;;
    esac
  done < <(git -C "$root" diff --no-renames --name-only -z "$base" "$head")
else
  [[ $(meta review.verdict) == pass ]] || die "$id has no passing review"
  reviewed=$(meta review.head)
  if [[ -n $reviewed ]]; then
    [[ $reviewed =~ ^[0-9a-f]{40}$ ]] ||
      die "review.head must be a full commit id, not a name that can move ($reviewed); review again"
    git -C "$root" cat-file -e "$reviewed^{commit}" 2>/dev/null ||
      die "the reviewed commit $reviewed is not in this repository; review again"
    # What the reviewed commit becomes on today's main. A neighbour's landing and a clean
    # rebase leave it equal to the bead; anything written after the review does not.
    merged=$(git -C "$root" merge-tree --write-tree "$base" "$reviewed" 2>/dev/null) ||
      die "the reviewed commit $reviewed no longer merges cleanly with main; review again"
    expected=${merged%%$'\n'*}
    # Compared entry by entry, so no diff setting or attribute decides what counts as a change.
    want=$(entries "$expected")
    have=$(entries "$head")
    [[ -n $want && $want == "$have" ]] ||
      die "$branch differs from the reviewed commit $reviewed (git diff $expected $head); review again"
  else
    # Passes recorded before scripts/review-head carry the patch-id of the whole diff.
    patch=$(git -C "$root" diff "$base" "$head" | git patch-id --verbatim | awk '{print $1}')
    [[ -n $(meta review.patch_id) && $(meta review.patch_id) == "$patch" ]] ||
      die "the diff changed since review ($patch vs $(meta review.patch_id)); review again"
  fi
  author=$(meta build.provider)
  reviewer=$(meta review.provider)
  [[ -n $author && -n $reviewer ]] || die "build.provider and review.provider must both be set on $id"
  [[ $author != "$reviewer" ]] || die "the reviewer's provider ($reviewer) is the author's"
fi

check_line
bd update "$id" --set-metadata land.sha="$head" >/dev/null
git -C "$root" merge --quiet --ff-only "$head"
finish "$head"
