# Prints the id a review pass is recorded against; scripts/land compares it. See docs/sdlc.md.
#   scripts/review-patch-id [<base> [<head>]]    defaults: the merge base with main, and HEAD
set -euo pipefail

head=${2:-HEAD}
base=${1:-$(git merge-base main "$head")}

# Written by scripts/watch-snapshot.ts. A test compares each with a fresh projection, so
# scripts/check vouches for these files and a reviewer does not have to.
generated=(
  fixtures/watch/inspect-1106.json
  fixtures/watch/snapshot-1106-unread.json
  fixtures/watch/snapshot-1106-unverified.json
  fixtures/watch/snapshot-1106.json
  fixtures/watch/snapshot-59d6895.json
  fixtures/watch/snapshot-bad.json
  fixtures/watch/snapshot-busy.json
  fixtures/watch/snapshot-calm.json
  fixtures/watch/snapshot-mixed-59d6895.json
)
paths=(':(top)')
for path in "${generated[@]}"; do
  paths+=(":(top,exclude)$path")
done

# No context lines: a neighbour's edit beside the bead's lines leaves the id alone.
id=$(git diff --no-ext-diff -U0 "$base" "$head" -- "${paths[@]}" | git patch-id --verbatim | awk '{print $1}')
echo "${id:-generated-only}"
