{
  "name": "@spi-code/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @spi-code/window build",
    "start": "pnpm run build && electron .",
    "smoke": "pnpm run build && electron . --smoke",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@spi-code/contracts": "workspace:*",
    "@spi-code/host": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.16.1"
  }
}
